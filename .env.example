# ═══════════════════════════════════════════════════════════════════════
# Chatbot Clínicas — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# For production, use strong random secrets (see `openssl rand -hex 32`).

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=development            # development | production | test
DEBUG=true                     # true | false
SECRET_KEY=change-me-to-a-random-secret

# ── Database ─────────────────────────────────────────────────────────────
# Production (PostgreSQL with async driver):
DATABASE_URL=postgresql+asyncpg://app:password@postgres:5432/chatbot_clinica
# Sync URL for Alembic migrations and Celery:
DATABASE_URL_SYNC=postgresql+psycopg2://app:password@postgres:5432/chatbot_clinica

# Development (overrides DATABASE_URL when set):
DB_PASSWORD=devpassword

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery ───────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-another-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Magic link expiration in minutes (used by auth flow):
MAGIC_LINK_EXPIRATION_MINUTES=15

# ── OpenAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ── Google Calendar ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
# Production:
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/calendar/callback

# ── WhatsApp (Evolution API) ────────────────────────────────────────────
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=your-evolution-api-key
# Webhook URL that Evolution API will call for incoming messages:
EVOLUTION_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/whatsapp/evolution

# ── Encryption (for tokens at rest) ─────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-to-a-32-byte-base64-key

# ── Frontend (Vite) ─────────────────────────────────────────────────────
# Used by the React SPA at build time (embedded in JS bundle):
VITE_API_URL=http://localhost:8000/api
# Production:
# VITE_API_URL=https://your-domain.com/api
